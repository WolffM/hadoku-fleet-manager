#!/bin/sh

# --- worktree preamble ---------------------------------------------------
# Same reasoning as pre-commit: core.hooksPath points at .husky (tracked), so
# this fires from a linked worktree too. Several agents share this checkout and
# every one of them pushes from a worktree.
[ "${HUSKY-}" = "0" ] && exit 0

# Install this worktree's own node_modules rather than linking the main
# checkout's (see the pre-commit preamble for why a link is wrong).
if [ ! -e node_modules ] && ! CI=true pnpm install --frozen-lockfile; then
	echo "❌ pnpm install failed. A private @wolffm package needs NODE_AUTH_TOKEN."
	exit 1
fi

# ONLY THE LEAK GUARDS, and only because this repo is PUBLIC: a push to `ppe`
# publishes to the world as surely as a push to `main` did. Correctness moved
# to CI, which runs `check` on every `ppe` push and promotes to `main` only
# what went green (docs/planning/ppe-promotion-2026-11-01.md). The full
# `pnpm run check` used to run here, ~10 minutes by 11-01, and every session
# then raced the others for a fast-forward of main; a push that loses a race
# to `ppe` now rebases and retries in seconds.

# FIRST, because it reads git's ref lines on stdin. The graft makes
# old-history branches look mergeable; a push of such a merge would publish
# the private history.
echo "🔒 Checking every pushed commit is public history..."
node scripts/check-public-history.mjs || exit 1

# The tracked tree must not locate the operator's network or home: private
# addresses, MACs, the tailnet name, the denylist (.publish-denylist, shared by
# every worktree). Under a second; CI runs it again inside `check`.
echo "🔒 Checking no tracked file carries a private address or denylisted name..."
node --test --test-reporter=dot scripts/lib/publish-safety-guard.test.mjs || exit 1
