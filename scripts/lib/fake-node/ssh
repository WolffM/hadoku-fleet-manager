#!/usr/bin/env bash
# The fake node's ssh (scripts/lib/fake-node.mjs): runOn puts the script on stdin;
# run it as the node would, under the fixture $HOME with the fakes first on PATH.
exec env HOME="$FAKE_NODE_HOME" PATH="$FAKE_NODE_BIN:$FAKE_REAL_PATH" TMPDIR="$FAKE_NODE_TMP" \
	CGROUP_ROOT="$FAKE_NODE_ROOT/cgroup" SYS_DIR="$FAKE_NODE_ROOT/etc/systemd/system" \
	USER_CONF_DIR="$FAKE_NODE_ROOT/etc/systemd/user.conf.d" IO_WAIT_SECS=0 \
	FAKE_STATE="$FAKE_STATE" bash -s
